# AI hold/route detection needs one of these keys. If both are set, Anthropic is used.
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any vision model on OpenRouter (default anthropic/claude-opus-5.5)
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Anthropic: https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# Optional: where the SQLite database and wall photos are stored (default ./data)
# DATA_DIR=./data
